{$APP_HOST} {
    encode gzip

    root * /srv

    handle /api/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}